# -----------------------------------------------------------------------------
# Environment variables for Principle Scenarios
# Copy this file to `.env` for local development.
# In Railway, set these in the service's Variables tab (do not commit .env).
# -----------------------------------------------------------------------------

# Mongo connection string.
# Local: mongodb://localhost:27017/principle-scenarios?directConnection=true
# Railway: use the connection string from MongoDB Atlas or Railway's Mongo plugin.
MONGODB_URI=mongodb://localhost:27017/principle-scenarios?directConnection=true

# Anthropic API key. Not used by the current MVP — placeholder for future LLM calls.
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Port. Railway injects this automatically in production — leave unset there.
PORT=3000

# 'development' locally, 'production' on Railway.
# Controls cookie security (secure flag + trust proxy) and prod warnings.
NODE_ENV=development

# Secret used to sign session cookies. MUST be changed for production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production

# Scheduler (reserved for future cron jobs; MVP doesn't use this).
ENABLE_SCHEDULER=false
CRON_SCHEDULE=0 */3 * * *
